---
import Layout from '~/layouts/PageLayout.astro';
import YouTubeEmbed from '~/components/common/YouTubeEmbed.astro';
import { Icon } from 'astro-icon/components';

const metadata = {
  title: 'Videos | Tuesday The Sky',
  description: 'Official music videos and visualizers for Tuesday The Sky',
};

const videos = [
  {
    title: `"Hypneurotic" (Official Video)`,
    album: 'The Blurred Horizon (2021)',
    videoId: 'QnwJl9QPyx0',
    notes: [
      `"Hypneurotic" is the lead single and centerpiece off Tuesday The Sky's second full-length album, "The Blurred Horizon".`,
      `Released via Metal Blade Records.`,
      `Features guest drummer Gavin Harrison (Porcupine Tree, King Crimson, The Pineapple Thief), who recorded two full drum kit takes panned left and right for an extraordinary "double drummer" dynamic.`,
      `Personnel: Jim Matheos (Guitars, Synthesizers, Bass, Programming), Gavin Harrison (Drums).`,
      `Published by Metal Blade Records. Order the album at <a href="https://www.metalblade.com/tuesdaythesky" target="_blank" rel="noopener noreferrer">metalblade.com/tuesdaythesky</a>.`,
    ],
  },
  {
    title: `"The Nearest Exit May Be Behind You" (Official Video)`,
    album: 'The Blurred Horizon (2021)',
    videoId: 'fIJgt9gdNak',
    notes: [
      `Official visualizer video for "The Nearest Exit May Be Behind You", taken from the sophomore album "The Blurred Horizon".`,
      `Directed and animated with evocative, dreamlike landscapes that echo the expansive atmosphere of the track.`,
      `Written, performed, and produced by Jim Matheos.`,
      `Released by Metal Blade Records.`,
    ],
  },
  {
    title: `"Vortex Street" (Official Video)`,
    album: 'Drift (2017)',
    videoId: 'rWIq6Wul8Fw',
    notes: [
      `The lead single and official video from Tuesday The Sky's acclaimed debut album, "Drift".`,
      `Official music video released worldwide by InsideOut Music.`,
      `Written, recorded, and produced by Jim Matheos.`,
      `Features an organic synthesis of atmospheric guitar layering, ambient electronics, and cinematic movement.`,
    ],
  },
  {
    title: `"Indoor Enthusiast" (Full Album Stream)`,
    album: 'Indoor Enthusiast (2026)',
    videoId: 'cqol-jxZYsE',
    notes: [
      `Full album stream for "Indoor Enthusiast", the third studio album from Tuesday The Sky.`,
      `All music written, performed, and produced by Jim Matheos.`,
      `Cover artwork and visual aesthetic created by Simon Ward (<a href="https://identity-media.co.uk/" target="_blank" rel="noopener noreferrer">identity-media.co.uk</a>).`,
    ],
  },
];
---

<Layout metadata={metadata}>
  <section class="max-w-6xl mx-auto px-4 py-12">
    <div class="text-center mb-12">
      <h1 class="text-4xl font-bold tracking-tight text-white sm:text-5xl">Videos</h1>
      <p class="mt-4 text-lg text-neutral-400 font-medium">Official Music Videos & Visualizers</p>
    </div>

    <div class="space-y-12">
      {
        videos.map((video) => (
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 items-stretch border border-neutral-800 bg-neutral-900/30 rounded-xl p-4 sm:p-6 shadow-lg">
            {/* Left Column: YouTube Facade (Click-to-Play via custom YouTubeEmbed) */}
            <div class="relative w-full aspect-video rounded-lg overflow-hidden border border-neutral-800 bg-black">
              <YouTubeEmbed id={video.videoId} title={video.title} class="w-full h-full" />
            </div>

            {/* Right Column: Scrollable Notes Section matching video height */}
            <div class="flex flex-col h-full max-h-[300px] md:max-h-none overflow-hidden rounded-lg border border-neutral-800/80 bg-neutral-900/60 p-5">
              <div class="mb-3 border-b border-neutral-800 pb-3 flex flex-wrap items-start justify-between gap-2">
                <div>
                  <h2 class="text-xl font-bold text-white">{video.title}</h2>
                  <span class="text-xs font-semibold uppercase tracking-wider text-neutral-400">{video.album}</span>
                </div>
                <a
                  href={`https://www.youtube.com/watch?v=${video.videoId}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 px-3 py-1 text-xs font-semibold text-red-300 hover:text-white bg-red-600/20 hover:bg-red-600 rounded-md border border-red-500/30 transition-all duration-150 shrink-0"
                >
                  <Icon name="tabler:brand-youtube" class="w-4 h-4 text-red-500 hover:text-white" />
                  <span>Watch on YouTube</span>
                  <Icon name="tabler:external-link" class="w-3 h-3 opacity-70" />
                </a>
              </div>
              <div class="overflow-y-auto flex-1 pr-2 text-sm text-neutral-300 space-y-3 custom-scrollbar [&_a]:text-accent [&_a]:underline hover:[&_a]:text-white">
                {video.notes.map((paragraph) => (
                  <p class="leading-relaxed" set:html={paragraph} />
                ))}
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </section>
</Layout>

<style>
  .custom-scrollbar::-webkit-scrollbar {
    width: 6px;
  }
  .custom-scrollbar::-webkit-scrollbar-track {
    background: rgba(255, 255, 255, 0.05);
    border-radius: 3px;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.2);
    border-radius: 3px;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb:hover {
    background: rgba(255, 255, 255, 0.4);
  }
</style>
