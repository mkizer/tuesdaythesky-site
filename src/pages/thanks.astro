---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import { getHomePermalink } from '~/utils/permalinks';

const metadata = {
  title: 'Thank You',
};
---

<Layout metadata={metadata}>
  <!-- HeroText Widget ******************* -->
  <HeroText tagline="Message Sent" title="Thank You!" />

  <section class="flex items-center h-full p-16">
    <div class="container flex flex-col items-center justify-center px-5 mx-auto my-8">
      <div class="max-w-md text-center">
        <p class="text-3xl font-semibold md:text-3xl">Your message has been received.</p>
        <p class="mt-4 mb-8 text-lg text-muted dark:text-slate-400">
          We appreciate you taking the time to contact us. We will get back to you as soon as possible.
          <br /><br />
          In the meantime, follow us on the social media links below.
        </p>
        <a rel="noopener noreferrer" href={getHomePermalink()} class="btn btn-primary">Back to homepage</a>
      </div>
    </div>
  </section>
</Layout>
