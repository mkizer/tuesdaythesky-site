---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Content from '~/components/widgets/Content.astro';

const metadata = {
  title: 'Music | Tuesday The Sky',
};
---

<Layout metadata={metadata}>
  <!-- HeroText Widget ******************* -->
  <HeroText title="Music" tagline="Tuesday The Sky" />

  <!-- Content Widget: Indoor Enthusiast (2026) ****************** -->
  <Content
    isAfterContent
    isBeforeContent
    isReversed={true}
    image={{
      src: '~/assets/images/IndoorEnthusiast_cover.png',
      alt: 'Tuesday The Sky - Indoor Enthusiast',
    }}
  >
    <Fragment slot="content">
      <h2 class="text-3xl font-bold tracking-tight dark:text-white sm:text-4xl mb-4 font-heading">Indoor Enthusiast</h2>
      <div class="space-y-4 text-justify">
        <p class="text-accent font-semibold">2026 Release</p>
      </div>
      <p>&nbsp;</p>
      <div class="mb-6 font-semibold dark:text-slate-200">
        <p>Album Details</p>
      </div>
      <div class="space-y-4 text-justify">
        <p>
          The third full-length album from Tuesday The Sky explores intimate, layered instrumental ambience with
          evocative rhythmic interplay and dynamic guitar expressions.
        </p>
      </div>
      <p>&nbsp;</p>
      <div class="mb-6 font-semibold dark:text-slate-200">
        <p>Written, Performed, and Produced By</p>
        <p>Jim Matheos</p>
        <p>&nbsp;</p>
        <p>Cover Artwork and Visual Identity</p>
        <p>
          Simon Ward (<a href="https://identity-media.co.uk/" target="_blank" class="hover:underline"
            >identity-media.co.uk</a
          >)
        </p>
      </div>
      <div class="mb-6 font-semibold dark:text-slate-200">
        <hr class="border-slate-800 my-4" />
        <p>
          Stream full album on <a
            href="https://www.youtube.com/watch?v=cqol-jxZYsE"
            target="_blank"
            class="text-accent hover:underline">YouTube</a
          >
        </p>
      </div>
    </Fragment>
  </Content>

  <!-- Content Widget: The Blurred Horizon (2021) ****************** -->
  <Content
    isBeforeContent
    isReversed={false}
    image={{
      src: '~/assets/images/TuesdayTheSky_TheBlurredHorizon_1024.jpg',
      alt: 'Tuesday The Sky - The Blurred Horizon (2021)',
    }}
  >
    <Fragment slot="content">
      <h2 class="text-3xl font-bold tracking-tight dark:text-white sm:text-4xl mb-4 font-heading">
        The Blurred Horizon
      </h2>
      <div class="space-y-4 text-justify">
        <p class="text-accent font-semibold">Released September 3, 2021 via Metal Blade Records</p>
      </div>
      <p>&nbsp;</p>
      <div class="mb-6 font-semibold dark:text-slate-200">
        <p>Track List</p>
      </div>
      <div class="space-y-1 text-justify text-sm">
        <p>1. Half 'Gator</p>
        <p>2. Clandestine</p>
        <p>3. The Blurred Horizon</p>
        <p>4. Everything Is Free</p>
        <p>5. Hypneurotic</p>
        <p>6. Later, Then Now</p>
        <p>7. Near Light</p>
        <p>8. Half 'Gator (Reprise)</p>
        <p>9. Vermilion</p>
      </div>
      <p>&nbsp;</p>
      <div class="mb-6 font-semibold dark:text-slate-200">
        <p>Personnel</p>
        <p>Jim Matheos – Guitars, Keyboards, Bass, Programming</p>
        <p>Gavin Harrison – Drums on "Hypneurotic" and "Everything Is Free"</p>
        <p>&nbsp;</p>
        <p>Produced and Mixed by Jim Matheos</p>
        <p>Mastered by Maor Appelbaum at Maor Appelbaum Mastering</p>
      </div>
      <div class="mb-6 font-semibold dark:text-slate-200">
        <hr class="border-slate-800 my-4" />
        <p>
          Purchase via <a
            href="https://www.metalblade.com/tuesdaythesky"
            target="_blank"
            class="text-accent hover:underline">Metal Blade Records</a
          >
        </p>
      </div>
    </Fragment>
  </Content>

  <!-- Content Widget: Drift (2017) ****************** -->
  <Content
    isBeforeContent
    isReversed={true}
    image={{
      src: '~/assets/images/tts_drift_cover_1024.jpg',
      alt: 'Tuesday The Sky - Drift (2017)',
    }}
  >
    <Fragment slot="content">
      <h2 class="text-3xl font-bold tracking-tight dark:text-white sm:text-4xl mb-4 font-heading">Drift</h2>
      <div class="space-y-4 text-justify">
        <p class="text-accent font-semibold">Released June 30, 2017 via InsideOut Music</p>
      </div>
      <p>&nbsp;</p>
      <div class="mb-6 font-semibold dark:text-slate-200">
        <p>Track List</p>
      </div>
      <div class="space-y-1 text-justify text-sm">
        <p>1. Drift</p>
        <p>2. Stella</p>
        <p>3. Roger, Gordo</p>
        <p>4. Westerlies</p>
        <p>5. Vortex Street</p>
        <p>6. It Comes in Waves</p>
        <p>7. Dyatlov Pass</p>
        <p>8. Far and Distant</p>
        <p>9. The Rowing</p>
      </div>
      <p>&nbsp;</p>
      <div class="mb-6 font-semibold dark:text-slate-200">
        <p>Personnel</p>
        <p>Jim Matheos – Guitars, Synthesizers, Programming</p>
        <p>Joey Vera – Bass</p>
        <p>Lloyd Hanney – Drums</p>
        <p>&nbsp;</p>
        <p>Produced and Mixed by Jim Matheos</p>
      </div>
      <div class="mb-6 font-semibold dark:text-slate-200">
        <hr class="border-slate-800 my-4" />
        <p>Listen on streaming platforms worldwide via InsideOut Music.</p>
      </div>
    </Fragment>
  </Content>
</Layout>
