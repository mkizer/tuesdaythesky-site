---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Content from '~/components/widgets/Content.astro';

const metadata = {
  title: 'Music | Tuesday The Sky',
};
---

<Layout metadata={metadata}>
  <!-- HeroText Widget ******************* -->
  <HeroText title="Music" tagline="Tuesday The Sky" />

  <!-- Content Widget: Indoor Enthusiast (2025) ****************** -->
  <Content
    isAfterContent
    isBeforeContent
    isReversed={true}
    image={{
      src: '~/assets/images/IndoorEnthusiast_cover.png',
      alt: 'Tuesday The Sky - Indoor Enthusiast (2025)',
    }}
  >
    <Fragment slot="content">
      <h2 class="text-3xl font-bold tracking-tight dark:text-white sm:text-4xl mb-4 font-heading">Indoor Enthusiast</h2>
      <div class="space-y-4 text-justify">
        <p class="text-accent font-semibold">Released on October 24, 2025</p>
      </div>
      <p>&nbsp;</p>
      <div class="mb-6 font-semibold dark:text-slate-200">
        <p>Track List</p>
      </div>
      <div class="space-y-4 text-justify">
        <p>
          1. The Nearest Exit May Be Behind You<br />
          2. Ghost Train<br />
          3. Zugzwang<br />
          4. Does It Need To Be So Loud?<br />
          5. Bends Toward Light<br />
          6. The Last Lonely Lamppost<br />
          7. Get Lost<br />
          8. Between Wind And Water<br />
          9. Memento Mori<br />
          10. Set Fire To The Stars<br />
          11. Closure
        </p>
      </div>
      <p>&nbsp;</p>
      <div class="mb-6 font-semibold dark:text-slate-200">
        <p>Performed and Produced by Jim Matheos</p>
        <p>&nbsp;</p>
        <p>
          Drums on The Nearest Exit May Be Behind You, Bend Toward Light, and Set Fire To The Stars by Dennis Leeflang
        </p>
        <p>&nbsp;</p>
        <p>Mixed by Jim Matheos</p>
        <p>Mastered by Jacob Hansen</p>
        <p>&nbsp;</p>
        <p>Photo by Jeremy Saffer</p>
        <p>&nbsp;</p>
        <p>Art Direction and Design by Simon Ward</p>
        <p>
          <a href="https://identity-media.co.uk/" target="_blank" class="hover:underline">www.identity-media.co.uk</a>
        </p>
        <p>&nbsp;</p>
        <p>All Songs Written by Jim Matheos</p>
        <p>Published by Matheos Music / BMI.</p>
        <p>Administered by BMG Rights Management.</p>
      </div>
      <div class="mb-6 font-semibold dark:text-slate-200">
        <hr class="border-slate-800 my-4" />
        <p>
          Purchase via <a
            href="https://www.metalblade.com/tuesdaythesky/"
            target="_blank"
            class="text-muted hover:text-gray-700 hover:underline dark:text-gray-400 transition duration-150 ease-in-out"
            >metalblade.com/tuesdaythesky</a
          > | <a
            href="https://link.amazon/B04kPjtwK"
            target="_blank"
            class="text-muted hover:text-gray-700 hover:underline dark:text-gray-400 transition duration-150 ease-in-out"
            >Amazon.com</a
          >
        </p>
      </div>
    </Fragment>
  </Content>

  <!-- Content Widget: The Blurred Horizon (2021) ****************** -->
  <Content
    isBeforeContent
    isReversed={false}
    image={{
      src: '~/assets/images/TuesdayTheSky_TheBlurredHorizon_1024.jpg',
      alt: 'Tuesday The Sky - The Blurred Horizon (2021)',
    }}
  >
    <Fragment slot="content">
      <h2 class="text-3xl font-bold tracking-tight dark:text-white sm:text-4xl mb-4 font-heading">
        The Blurred Horizon
      </h2>
      <div class="space-y-4 text-justify">
        <p class="text-accent font-semibold">Released on September 3, 2021</p>
      </div>
      <p>&nbsp;</p>
      <div class="mb-6 font-semibold dark:text-slate-200">
        <p>Track List</p>
      </div>
      <div class="space-y-4 text-justify">
        <p>
          1. Half Remembered<br />
          2. Near Light<br />
          3. Cwmwl<br />
          4. Where The Enemy Sleeps<br />
          5. Laudanum Dream<br />
          6. Hypneurotic<br />
          7. Later, Then Now<br />
          8. Near Dark<br />
          9. Half Forgotten<br />
          10. The Blurred Horizon<br />
          11. Everything Is Free
        </p>
      </div>
      <p>&nbsp;</p>
      <div class="mb-6 font-semibold dark:text-slate-200">
        <p>Performed and</p>
        <p>Produced by</p>
        <p>Jim Matheos</p>
        <p>&nbsp;</p>
        <p>Drums on</p>
        <p>Half Remembered</p>
        <p>Near Light</p>
        <p>Hypneurotic</p>
        <p>Half Forgotten</p>
        <p>The Blurred Horizon</p>
        <p>Gavin Harrison</p>
        <p>&nbsp;</p>
        <p>Vocals on</p>
        <p>Everything Is Free</p>
        <p>Tim Bowness</p>
        <p>&nbsp;</p>
        <p>Mixed by</p>
        <p>Jim Matheos</p>
        <p>&nbsp;</p>
        <p>Mastered by</p>
        <p>Phil Magnotti</p>
        <p>&nbsp;</p>
        <p>All Images Courtesy of</p>
        <p>Chris Friel</p>
        <p>&nbsp;</p>
        <p>Layout and Design by</p>
        <p>BMDEN / Etchimageco.com</p>
        <p>&nbsp;</p>
        <p>Thanks to Brian S, Tracy,</p>
        <p>Stephanie, Gavin, Tim,</p>
        <p>Phil, Kevin, Mike, Chris,</p>
        <p>Brian M, Laurie, Lindsay</p>
        <p>&nbsp;</p>
        <p>
          All Songs Written by Jim Matheos and Published by Matheos Music / BMI., Administered by BMG Rights Management,
          Except Everything Is Free by Gillian Welch and David Rawlings, Published by Irving Music Inc., Say Uncle
          Music, Cracklin' Music, BMI
        </p>
      </div>
      <div class="mb-6 font-semibold dark:text-slate-200">
        <hr class="border-slate-800 my-4" />
        <p>
          Purchase via <a
            href="https://www.metalblade.com/tuesdaythesky/"
            target="_blank"
            class="text-muted hover:text-gray-700 hover:underline dark:text-gray-400 transition duration-150 ease-in-out"
            >metalblade.com/tuesdaythesky</a
          > | <a
            href="https://link.amazon/B0fRdSQpp"
            target="_blank"
            class="text-muted hover:text-gray-700 hover:underline dark:text-gray-400 transition duration-150 ease-in-out"
            >Amazon.com</a
          >
        </p>
      </div>
    </Fragment>
  </Content>

  <!-- Content Widget: Drift (2017) ****************** -->
  <Content
    isBeforeContent
    isReversed={true}
    image={{
      src: '~/assets/images/tts_drift_cover_1024.jpg',
      alt: 'Tuesday The Sky - Drift (2017)',
    }}
  >
    <Fragment slot="content">
      <h2 class="text-3xl font-bold tracking-tight dark:text-white sm:text-4xl mb-4 font-heading">Drift</h2>
      <div class="space-y-4 text-justify">
        <p class="text-accent font-semibold">Released on June 30, 2017</p>
      </div>
      <p>&nbsp;</p>
      <div class="mb-6 font-semibold dark:text-slate-200">
        <p>Track List</p>
      </div>
      <div class="space-y-4 text-justify">
        <p>
          1. Today the Sky<br />
          2. Kite<br />
          3. Vortex Street<br />
          4. It Comes in Waves<br />
          5. Dyatlov Pass<br />
          6. Far and Away<br />
          7. Westerlies<br />
          8. Roger, Gordo<br />
          9. The Rowing Endeth<br />
          10. Drift
        </p>
      </div>
      <p>&nbsp;</p>
      <div class="mb-6 font-semibold dark:text-slate-200">
        <p>Jim Matheos - guitars and bass</p>
        <p>Lloyd Hanney - drums</p>
        <p>Anna-Lynne Williams - vocals on Vortex Street and Westerlies</p>
        <p>Kevin Moore - keyboards on It Comes in Waves and Drift</p>
        <p>&nbsp;</p>
        <p>Mixed by Phil Magnotti and Jim Matheos</p>
        <p>Mastered by Phil Magnotti at Silvermine Studios</p>
        <p>&nbsp;</p>
        <p>Illustrations and logo by Jan Tomic</p>
        <p>&nbsp;</p>
        <p>Drums recorded at Quill Lane Studios, Glen of the Downs, Ireland</p>
        <p>Lloyd Hanney plays Ludwig, Paiste, ProMark, Evans, and PureSound</p>
        <p>&nbsp;</p>
        <p>Thanks - Thomas, Leif, Lloyd, Anna-Lynne, Kevin, Phil, Torsten, Jan, Laurie, Lindsay</p>
        <p>&nbsp;</p>
        <p>
          All Songs Written by Jim Matheos and published by Matheos Music / BMI, administered by BMG Rights Management,
          except Vortex Street, written by Jim Matheos and Anne-Lynne Williams, published by Matheos Music / BMI,
          administered by BMG Rights Management, and I'll Be Fine Music / ASCAP, administered by Warner Chappell Misc.
        </p>
      </div>
      <div class="mb-6 font-semibold dark:text-slate-200">
        <hr class="border-slate-800 my-4" />
        <p>
          Purchase via <a
            href="https://www.metalblade.com/tuesdaythesky/"
            target="_blank"
            class="text-muted hover:text-gray-700 hover:underline dark:text-gray-400 transition duration-150 ease-in-out"
            >metalblade.com/tuesdaythesky</a
          > | <a
            href="https://link.amazon/B0cOUUYTZ"
            target="_blank"
            class="text-muted hover:text-gray-700 hover:underline dark:text-gray-400 transition duration-150 ease-in-out"
            >Amazon.com</a
          >
        </p>
      </div>
    </Fragment>
  </Content>
</Layout>
