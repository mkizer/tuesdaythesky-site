---
import Layout from '~/layouts/PageLayout.astro';

import Note from '~/components/widgets/Note.astro';
import Content from '~/components/widgets/Content.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import YouTubeEmbed from '~/components/common/YouTubeEmbed.astro';

const metadata = {
  title: 'Tuesday The Sky',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Content Widget **************** -->

  <Content
    isAfterContent
    isBeforeContent
    isReversed
    items={[
      {
        title: 'Atmospheric & Instrumental Soundscapes',
        description:
          'Formed by guitarist/composer Jim Matheos (Fates Warning, OSI, North Sea Echoes), Tuesday The Sky explores immersive textures, cinematic guitar looping, ambient synth foundations, and expressive rhythms.',
      },
    ]}
    image={{
      src: '~/assets/images/IndoorEnthusiast_cover.png',
      alt: 'Tuesday The Sky - Indoor Enthusiast',
      caption: 'Artwork by Simon Ward',
      captionJustification: 'right',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2 font-heading">Tuesday The Sky</h3>
      <p class="text-muted dark:text-slate-400">The instrumental and ambient music project by Jim Matheos</p>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-slate-100 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Note Widget ******************* -->

  <Note title="Indoor Enthusiast" description="~ the new album from Tuesday The Sky" />

  <!-- Content Widget **************** -->

  <Content
    isAfterContent
    isBeforeContent
    image={{
      src: '~/assets/images/TuesdayTheSky_TheBlurredHorizon_1024.jpg',
      alt: 'The Blurred Horizon',
      caption: 'The Blurred Horizon (Metal Blade Records)',
      captionJustification: 'center',
    }}
  >
    <Fragment slot="content">
      <h4 class="text-xl font-bold mb-3 dark:text-white">Featured Videos</h4>
      <YouTubeEmbed id="QnwJl9QPyx0" title="Hypneurotic (feat. Gavin Harrison)" class="w-full max-w-[560px]" />
      <br />
      <YouTubeEmbed id="rWIq6Wul8Fw" title="Vortex Street (Official Video)" class="w-full max-w-[560px]" />
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-slate-100 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- LatestPosts Widget ******* -->

  <BlogLatestPosts
    isBeforeContent
    title="Latest News"
    information={`The latest news, announcements, and updates from Tuesday The Sky.`}
  />

  <!-- CallToAction Widget *********** -->

  <CallToAction
    image={{
      src: '~/assets/images/IndoorEnthusiast_cover.png',
      alt: 'Indoor Enthusiast',
      width: 300,
      height: 300,
    }}
    imagePosition="left"
    actions={[
      {
        variant: 'primary',
        text: 'Listen / Watch',
        href: 'https://www.youtube.com/watch?v=cqol-jxZYsE',
        target: '_blank',
        icon: 'tabler:external-link',
      },
    ]}
  >
    <Fragment slot="title">
      <span class="sm:whitespace-nowrap">"Indoor Enthusiast"</span>
    </Fragment>

    <Fragment slot="subtitle">New album available now</Fragment>
  </CallToAction>
</Layout>
