---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Content from '~/components/widgets/Content.astro';
import Image from '~/components/common/Image.astro';
import { Icon } from 'astro-icon/components';

const metadata = {
  title: 'Bio | Tuesday The Sky',
  description: 'Biography and project background for Tuesday The Sky and Jim Matheos',
};
---

<Layout metadata={metadata}>
  <!-- HeroText Widget ******************* -->
  <HeroText title="Biography" tagline="Tuesday The Sky" />

  <!-- Artist Profile Widget ******************* -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 mb-12">
    <div class="flex flex-col items-center text-center group">
      <div
        class="relative w-48 h-48 sm:w-56 sm:h-56 rounded-full overflow-hidden shadow-lg border-4 border-slate-300 dark:border-slate-700 transition-transform duration-300 group-hover:scale-105"
      >
        <Image
          src="~/assets/images/gallery/2021_01.png"
          alt="Jim Matheos"
          class="object-cover w-full h-full"
          width={300}
          height={300}
        />
      </div>
      <h3 class="mt-6 text-2xl font-bold tracking-tight dark:text-white font-heading">Jim Matheos</h3>
      <p class="text-stone-600 dark:text-slate-400 text-sm mt-1">Guitars / Synthesizers / Programming / Production</p>
      <div class="w-12 h-0.5 bg-primary my-3"></div>
      <div class="flex space-x-4 mt-2">
        <a
          href="https://www.facebook.com/TuesdaytheSky/"
          target="_blank"
          rel="noopener noreferrer"
          class="text-stone-500 hover:text-primary dark:text-stone-400 dark:hover:text-primary transition-colors"
          aria-label="Tuesday The Sky Facebook"
        >
          <Icon name="tabler:brand-facebook" class="w-6 h-6" />
        </a>
        <a
          href="https://jimmatheos.com/"
          target="_blank"
          rel="noopener noreferrer"
          class="text-stone-500 hover:text-primary dark:text-stone-400 dark:hover:text-primary transition-colors"
          aria-label="Jim Matheos Website"
        >
          <Icon name="tabler:world" class="w-6 h-6" />
        </a>
      </div>
    </div>
  </section>

  <!-- Content Widget: The Vision of Tuesday The Sky ****************** -->
  <Content
    isAfterContent
    isBeforeContent
    isReversed={true}
    image={{
      src: '~/assets/images/IndoorEnthusiast_cover.png',
      alt: 'Tuesday The Sky - Indoor Enthusiast',
      caption: 'Artwork by Simon Ward (2026)',
      captionJustification: 'right',
    }}
  >
    <Fragment slot="content">
      <h2 class="text-3xl font-bold tracking-tight dark:text-white sm:text-4xl mb-4 font-heading">
        Ambient & Instrumental Exploration
      </h2>
      <div class="space-y-4 text-justify text-slate-700 dark:text-slate-300">
        <p>
          Best known as the founding guitarist and primary composer of progressive metal pioneers
          <strong>Fates Warning</strong>, as well as co-founder of <strong>OSI</strong>,
          <strong>North Sea Echoes</strong>, and <strong>Kings of Mercia</strong>, <strong>Jim Matheos</strong>
          has spent decades expanding the boundaries of heavy and progressive guitar music.
        </p>
        <p>
          With <strong>Tuesday The Sky</strong>, Matheos steps into a completely different artistic realm: an ambient,
          cinematic, and predominantly instrumental journey focused on emotive sound design, layered guitar textures,
          hypnotic rhythmic pulses, and introspective depth.
        </p>
        <p>
          What began as personal musical sketches evolved into a compelling standalone catalog that invites listeners to
          drift through rich sonic atmospheres.
        </p>
      </div>
    </Fragment>
  </Content>

  <!-- Content Widget: The Albums ****************** -->
  <Content
    isBeforeContent
    isReversed={false}
    image={{
      src: '~/assets/images/TuesdayTheSky_TheBlurredHorizon_1024.jpg',
      alt: 'The Blurred Horizon (2021)',
      caption: 'The Blurred Horizon (Metal Blade Records)',
      captionJustification: 'left',
    }}
  >
    <Fragment slot="content">
      <h2 class="text-3xl font-bold tracking-tight dark:text-white sm:text-4xl mb-4 font-heading">The Discography</h2>
      <div class="space-y-4 text-justify text-slate-700 dark:text-slate-300">
        <p>
          <strong>Drift (2017)</strong> – Released via InsideOut Music, the debut album introduced the project's signature
          blend of ambient guitars, electronic foundations, and subtle rhythms. The album featured guest appearances from
          longtime collaborator Joey Vera on bass and Lloyd Hanney on drums.
        </p>
        <p>
          <strong>The Blurred Horizon (2021)</strong> – Arriving on Metal Blade Records, the sophomore record delved deeper
          into minimalist, meditative territories while expanding sonic contrast. Standout centerpiece "Hypneurotic" featured
          two distinct drum takes tracked by virtuoso drummer Gavin Harrison (Porcupine Tree, King Crimson), creating a stunning
          double-drummer dynamic.
        </p>
        <p>
          <strong>Indoor Enthusiast (2026)</strong> – The third chapter marks a mesmerizing return to Tuesday The Sky's evocative
          soundscapes, featuring album packaging and visual identity crafted by acclaimed artist Simon Ward.
        </p>
      </div>
    </Fragment>
  </Content>
</Layout>
