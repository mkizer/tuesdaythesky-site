---
import '@fontsource-variable/inter';

// 'DM Sans'
// Nunito
// Dosis
// Outfit
// Roboto
// Literata
// 'IBM Plex Sans'
// Karla
// Poppins
// 'Fira Sans'
// 'Libre Franklin'
// Inconsolata
// Raleway
// Oswald
// 'Space Grotesk'
// Urbanist
---

<style is:inline>
  :root {
    --aw-font-sans: 'Inter Variable';
    --aw-font-serif: 'Inter Variable';
    --aw-font-heading: 'Inter Variable';

    --aw-color-primary: #d62a26;
    --aw-color-secondary: #b82420;
    --aw-color-accent: #e04844;

    --aw-color-text-heading: #0f1115;
    --aw-color-text-default: #1e2024;
    --aw-color-text-muted: rgb(30 32 36 / 66%);
    --aw-color-bg-page: #f5f6f8;

    --aw-color-bg-page-dark: #111215;

    ::selection {
      background-color: #fee2e2;
      color: #991b1b;
    }
  }

  .dark {
    --aw-font-sans: 'Inter Variable';
    --aw-font-serif: 'Inter Variable';
    --aw-font-heading: 'Inter Variable';

    --aw-color-primary: #d62a26;
    --aw-color-secondary: #b82420;
    --aw-color-accent: #e04844;

    --aw-color-text-heading: #f3f4f6;
    --aw-color-text-default: #e2e5ea;
    --aw-color-text-muted: rgb(226 229 234 / 66%);
    --aw-color-bg-page: #111215;

    ::selection {
      background-color: #d62a26;
      color: #ffffff;
    }
  }
</style>
