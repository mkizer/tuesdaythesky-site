---
import { Icon } from 'astro-icon/components';
import { twMerge } from 'tailwind-merge';

export interface Props {
  id: string;
  title?: string;
  class?: string;
  poster?: string;
  posterQuality?: 'max' | 'high' | 'default';
  showWatchLink?: boolean;
}

const {
  id,
  title = 'YouTube video player',
  class: className = '',
  poster,
  posterQuality = 'high',
  showWatchLink = true,
} = Astro.props;

// Extract 11-character YouTube video ID from either an ID or URL
function extractYouTubeId(urlOrId: string): string {
  if (/^[A-Za-z0-9_-]{11}$/.test(urlOrId)) {
    return urlOrId;
  }
  const match = urlOrId.match(/(?:youtu\.be\/|youtube\.com\/(?:embed\/|v\/|watch\?v=|watch\?.+&v=))([\w-]{11})/);
  return match ? match[1] : urlOrId;
}

const videoId = extractYouTubeId(id);

const qualityFile = {
  max: 'maxresdefault',
  high: 'hqdefault',
  default: 'mqdefault',
}[posterQuality];

const posterUrl = poster || `https://i.ytimg.com/vi/${videoId}/${qualityFile}.jpg`;
const watchUrl = `https://www.youtube.com/watch?v=${videoId}`;
---

<div class={twMerge('relative aspect-video w-full rounded-lg overflow-hidden bg-black shadow-md group', className)}>
  <div
    class="yt-embed-facade absolute inset-0 w-full h-full cursor-pointer bg-cover bg-center flex items-center justify-center select-none"
    style={`background-image: url('${posterUrl}')`}
    data-videoid={videoId}
    data-title={title}
    role="button"
    tabindex="0"
    aria-label={`Play video: ${title}`}
  >
    {/* Dark subtle overlay for contrast */}
    <div class="absolute inset-0 bg-black/25 group-hover:bg-black/10 transition-colors duration-200"></div>

    {/* Big Play Button */}
    <button
      type="button"
      tabindex="-1"
      class="relative z-10 w-16 h-12 sm:w-20 sm:h-14 bg-red-600/90 group-hover:bg-red-600 text-white rounded-2xl flex items-center justify-center shadow-2xl transition-all duration-200 transform group-hover:scale-110 focus:outline-none"
      aria-hidden="true"
    >
      <svg class="w-6 h-6 sm:w-7 sm:h-7 fill-current ml-1" viewBox="0 0 24 24">
        <path d="M8 5v14l11-7z"></path>
      </svg>
    </button>

    {/* Fallback direct link in bottom corner */}
    {
      showWatchLink && (
        <a
          href={watchUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="yt-watch-direct absolute bottom-2 right-2 z-20 inline-flex items-center gap-1.5 px-2.5 py-1 text-xs font-medium text-white bg-black/75 hover:bg-black rounded-md border border-neutral-700/60 backdrop-blur-xs transition-colors duration-150"
          title="Open directly on YouTube"
        >
          <Icon name="tabler:brand-youtube" class="w-3.5 h-3.5 text-red-500" />
          <span>Watch on YouTube</span>
          <Icon name="tabler:external-link" class="w-3 h-3 text-neutral-400" />
        </a>
      )
    }
  </div>
</div>

<script>
  function setupYouTubeEmbeds() {
    const facades = document.querySelectorAll('.yt-embed-facade:not([data-initialized])');
    facades.forEach((facade) => {
      facade.setAttribute('data-initialized', 'true');

      const activate = () => {
        const videoId = facade.getAttribute('data-videoid');
        const title = facade.getAttribute('data-title') || 'YouTube video player';
        if (!videoId) return;

        const iframe = document.createElement('iframe');
        iframe.src = `https://www.youtube.com/embed/${encodeURIComponent(videoId)}?autoplay=1&playsinline=1`;
        iframe.title = title;
        iframe.allow =
          'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
        iframe.allowFullscreen = true;
        iframe.referrerPolicy = 'strict-origin-when-cross-origin';
        iframe.className = 'absolute inset-0 w-full h-full border-0';

        const parent = facade.parentElement;
        if (parent) {
          parent.innerHTML = '';
          parent.appendChild(iframe);
          iframe.focus();
        }
      };

      facade.addEventListener('click', (e) => {
        // Prevent click if user clicked the direct watch link
        const target = e.target as HTMLElement | null;
        if (target && target.closest('.yt-watch-direct')) return;
        activate();
      });

      facade.addEventListener('keydown', (e: Event) => {
        const keyEvent = e as KeyboardEvent;
        if (keyEvent.key === 'Enter' || keyEvent.key === ' ') {
          keyEvent.preventDefault();
          activate();
        }
      });
    });
  }

  // Setup on initial load and on Astro view transitions
  setupYouTubeEmbeds();
  document.addEventListener('astro:page-load', setupYouTubeEmbeds);
</script>
